{
  "expo": {
    "name": "Did You?",
    "slug": "did-you-android",
    "scheme": "didyou",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.orsmo.didyou",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#12121E"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Did You? to select a profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {}
    }
  }
}
